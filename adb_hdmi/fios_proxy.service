[Unit]
Description=Fios TV+ / ZowieBox proxy for Channels DVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Deploy the adb_hdmi/ directory's contents here (or update these two
# paths to wherever you actually placed them) -- this repo moved
# fios_proxy.py etc. out of the repo root and into adb_hdmi/.
WorkingDirectory=/root/adb_hdmi
ExecStart=/usr/bin/python3 /root/adb_hdmi/fios_proxy.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Direct-from-VMS Channels DVR proxy (dms_proxy.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kali
Group=kali
WorkingDirectory=/root/Repo/fios_proxy
ExecStart=./venv/bin/python3 ./dms_proxy.py
Restart=on-failure
RestartSec=5

# journalctl -u dms-proxy -f  to watch STREAM START/END lines live
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dms-proxy

[Install]
WantedBy=multi-user.target

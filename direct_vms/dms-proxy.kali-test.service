# TEST deployment only (kali box) -- not what runs in production.
# Production is dms-proxy.service, colocated with fios_proxy.py and
# Channels DVR in the "channels" LXC, running as root. This variant only
# differs in User/Group; see PROJECT_NOTES.md's 2026-09-23 deployment-
# topology note.

[Unit]
Description=Direct-from-VMS Channels DVR proxy (dms_proxy.py) -- kali test deployment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kali
Group=kali
WorkingDirectory=/root/Repo/fios_proxy/direct_vms
ExecStart=/root/Repo/fios_proxy/venv/bin/python3 ./dms_proxy.py
Restart=on-failure
RestartSec=5

# journalctl -u dms-proxy -f  to watch STREAM START/END lines live
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dms-proxy

[Install]
WantedBy=multi-user.target
